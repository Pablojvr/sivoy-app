PORT=3000
FRONTEND_URL=http://localhost:4200,http://localhost:3000
DB_PATH=sivoy.db
# La app usa la URL pooled; migraciones y advisory locks requieren URL directa.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Clave restringida a Places API (New). Nunca se expone al navegador.
GOOGLE_MAPS_API_KEY=
MAPBOX_PUBLIC_TOKEN=
# Orígenes HTTPS exactos autorizados para logos públicos, separados por coma.
PUBLIC_MEDIA_ORIGINS=

# Límites HTTP seguros. Los valores se expresan en bytes o milisegundos.
HTTP_JSON_LIMIT_BYTES=262144
HTTP_URLENCODED_LIMIT_BYTES=65536
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_HEADERS_COUNT=100

# Timeouts PostgreSQL de aplicación (milisegundos).
DB_STATEMENT_TIMEOUT_MS=5000
# Siempre se eleva al menos 1000 ms sobre DB_STATEMENT_TIMEOUT_MS.
DB_QUERY_TIMEOUT_MS=6000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000

# Logos multipart: 2 MB por defecto; solo JPEG, PNG o WebP.
UPLOAD_MAX_FILE_SIZE_BYTES=2097152

# Imágenes de puntos enviadas como Data URI a Cloudinary.
CLOUDINARY_TIMEOUT_MS=8000
CLOUDINARY_MAX_DATA_URI_BYTES=3145728

# Proveedores externos de mapas y búsqueda de lugares.
GOOGLE_PLACES_TIMEOUT_MS=8000
GOOGLE_PLACES_MAX_RESPONSE_BYTES=262144
MAPS_RESOLVER_TIMEOUT_MS=8000
MAPS_RESOLVER_MAX_BODY_BYTES=16384

# Rate limit por riesgo. `observe` solo registra; `enforce` responde 429.
# Desarrollo local puede usar `observe`; staging y producción deben sobrescribirlo con `enforce`.
# needs_validation(delivery-platform/rate-limit-store-fail-open): validar el comportamiento
# del almacenamiento externo en una tarea separada antes de depender de él en producción.
RATE_LIMIT_MODE=observe
RATE_LIMIT_CATALOG_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_MAPS_PER_MINUTE=20
# IPv6 se agrupa por subred para impedir rotación de direcciones.
RATE_LIMIT_IPV6_SUBNET=56
